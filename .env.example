# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Vision AI (Page Inspector, P8). Key 1 is used first; key 2 is the fallback
# when key 1 fails (quota, revoked, network).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Case-File Writer narration (P10)
GROQ_API_KEY=

# Certificate Forensics (P11): SSLMate CT Search API, free tier (unauthenticated: ~10 lookups per window)
SSLMATE_API_KEY=

# Live certificate-transparency feed (P12). Self-hosted certstream-server-go;
# wss://api.certstream.dev/ is for development only.
CERTSTREAM_URL=ws://localhost:8080/

# 1 = never touch the network (demo fallback mode, P12)
DOPPEL_OFFLINE=0
