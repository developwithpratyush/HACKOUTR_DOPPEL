{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doppel.local/contracts/registry.schema.json",
  "title": "Doppel brand registry (data/brands/registry.yaml)",
  "description": "v1.1. The protected brands, their genuine families and the trust anchors the Family Verifier uses. Read by the Family Verifier and Trick Detector; filled by the data phase (P1). v1.1 (P1) adds brand_tld_registry and per-brand user_content_hosts, both additive.",
  "type": "object",
  "required": [
    "schema_version",
    "updated",
    "restricted_registries",
    "lure_words",
    "brands"
  ],
  "additionalProperties": false,
  "$defs": {
    "hostname": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Lowercase ASCII; IDNs in punycode."
    },
    "source": {
      "description": "Where we confirmed it (the brand's or registry's own page). null = not verified yet.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_on": {
      "description": "Date we last confirmed it. null = still to verify (the Family Verifier still uses it, but reports it as unverified).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lure_word": {
      "type": "object",
      "required": [
        "word",
        "lang",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "word": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "hinglish",
            "hi"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "account",
            "payment",
            "delivery",
            "government",
            "reward",
            "urgency",
            "security",
            "support"
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "enum": [
        1
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "restricted_registries": {
      "type": "array",
      "description": "Suffixes where only vetted organisations can register (proof b).",
      "items": {
        "type": "object",
        "required": [
          "suffix",
          "who_can_register",
          "source",
          "verified_on"
        ],
        "additionalProperties": false,
        "properties": {
          "suffix": {
            "$ref": "#/$defs/hostname"
          },
          "who_can_register": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "verified_on": {
            "$ref": "#/$defs/verified_on"
          }
        },
        "if": {
          "properties": {
            "verified_on": {
              "type": "string"
            }
          }
        },
        "then": {
          "properties": {
            "source": {
              "type": "string"
            }
          }
        }
      }
    },
    "lure_words": {
      "type": "array",
      "description": "The shared lure lexicon (English + Hinglish). Brand-specific words go under each brand.",
      "items": {
        "$ref": "#/$defs/lure_word"
      }
    },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "brand_tlds",
          "restricted_suffixes",
          "genuine_family",
          "lure_words",
          "logo"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Used as target_brand.id in verdicts."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "description": "Tokens that name the brand inside a domain (combosquat parsing).",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "brand_tlds": {
            "type": "array",
            "description": "Closed brand TLDs (proof a): every name under them is the brand's.",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+$"
            },
            "uniqueItems": true
          },
          "restricted_suffixes": {
            "type": "array",
            "description": "Restricted registries this brand uses; each must appear in restricted_registries.",
            "items": {
              "$ref": "#/$defs/hostname"
            },
            "uniqueItems": true
          },
          "genuine_family": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "domain",
                "include_subdomains",
                "proof",
                "source",
                "verified_on"
              ],
              "additionalProperties": false,
              "properties": {
                "domain": {
                  "$ref": "#/$defs/hostname"
                },
                "include_subdomains": {
                  "type": "boolean",
                  "description": "true: any host under this domain is also genuine (e.g. onlinesbi.sbi.bank.in under sbi.bank.in)."
                },
                "proof": {
                  "type": "string",
                  "enum": [
                    "brand_tld",
                    "restricted_registry",
                    "official_list"
                  ],
                  "description": "Which of the three proofs makes this entry trustworthy."
                },
                "source": {
                  "$ref": "#/$defs/source"
                },
                "verified_on": {
                  "$ref": "#/$defs/verified_on"
                },
                "note": {
                  "type": "string"
                }
              },
              "if": {
                "properties": {
                  "verified_on": {
                    "type": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "lure_words": {
            "type": "array",
            "description": "Brand-specific lures (e.g. 'yono' for SBI, 'challan' for Parivahan).",
            "items": {
              "$ref": "#/$defs/lure_word"
            }
          },
          "logo": {
            "description": "Path relative to the repo root, e.g. data/brands/logos/sbi.png. null until collected.",
            "type": [
              "string",
              "null"
            ]
          },
          "exact_aliases": {
            "type": "array",
            "description": "v1.2 (P11): aliases that count only as a whole token or exact name, never as a look-alike target (short or common strings: 'npci' ~ 'cpci', 'rupay' ~ 'repay'). Each must also be in aliases.",
            "items": { "type": "string", "pattern": "^[a-z0-9]+$" },
            "uniqueItems": true
          },
          "legal_names": {
            "type": "array",
            "description": "v1.2 (P11): the brand's validated legal names as they appear in the Organisation (O=) field of its OV/EV certificates. Certificate Forensics (C16) matches them exactly (case-folded, never a substring), and the country too when given.",
            "items": {
              "type": "object",
              "required": ["name", "source", "verified_on"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 2 },
                "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
                "source": { "$ref": "#/$defs/source" },
                "verified_on": { "$ref": "#/$defs/verified_on" },
                "note": { "type": "string" }
              }
            }
          },
          "user_content_hosts": {
            "type": "array",
            "description": "Hosts inside the family where ANYONE can publish (Google Forms, Sites, Docs). Ownership proves nothing about who wrote the page, so the Family Verifier must never fire H1 for them; it reports 'brand-owned user-content platform' instead.",
            "items": {
              "type": "object",
              "required": [
                "host",
                "what",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "host": {
                  "$ref": "#/$defs/hostname"
                },
                "what": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "$ref": "#/$defs/source"
                }
              }
            }
          }
        }
      }
    },
    "brand_tld_registry": {
      "type": "array",
      "description": "Closed brand TLDs with their IANA record (proof a). Every brand.brand_tlds entry must appear here.",
      "items": {
        "type": "object",
        "required": [
          "tld",
          "brand",
          "manager",
          "source",
          "verified_on"
        ],
        "additionalProperties": false,
        "properties": {
          "tld": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "brand id"
          },
          "manager": {
            "type": "string",
            "minLength": 1,
            "description": "Registry operator as listed by IANA"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "verified_on": {
            "$ref": "#/$defs/verified_on"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
